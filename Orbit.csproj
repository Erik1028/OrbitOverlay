<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>OrbitOverlay</AssemblyName>
    <AssemblyTitle>OrbitOverlay</AssemblyTitle>
    <RootNamespace>Orbit</RootNamespace>
    <Version>1.15.1</Version>
    <!-- "Orbit" up to 1.7.1 (the 1.6 updater only installed that); 1.7's updater accepts both names -->
    <Product>OrbitOverlay</Product>
    <Description>Wrist watch, desktop mirrors and a VR keyboard for SteamVR</Description>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>assets\orbit.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);CS0649;CS0169;CA1416;CS8981</NoWarn>
    <!-- smaller installer: only the English (built-in) resources of WinForms; there are no Hungarian ones anyway,
         and the app's own text does not come from them (MessageBox buttons / file dialogs are Windows') -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.XAudio2" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="third_party\openvr\openvr_api.dll" CopyToOutputDirectory="PreserveNewest" Link="openvr_api.dll" />
    <None Include="assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="orbit.vrmanifest" CopyToOutputDirectory="PreserveNewest" />
    <!-- also embedded, so a single-file build / the installer can write them next to the exe -->
    <EmbeddedResource Include="assets\*.json" LogicalName="files/assets/%(Filename)%(Extension)" />
    <EmbeddedResource Include="orbit.vrmanifest" LogicalName="files/orbit.vrmanifest" />
    <EmbeddedResource Include="docs\CHANGELOG.md" LogicalName="whatsnew/CHANGELOG.md" />
    <EmbeddedResource Include="docs\OrbitOverlay Quick Start.txt" LogicalName="files/OrbitOverlay Quick Start.txt" />
    <!-- the PawnIO module that reads an AMD Ryzen's temperature (Sys/Temps.cs; LGPL 2.1, third_party/pawnio/README.txt) -->
    <EmbeddedResource Include="third_party\pawnio\AMDFamily17.bin" LogicalName="pawnio/AMDFamily17.bin" />
  </ItemGroup>

  <!-- Smaller installer: a self-contained publish copies the WHOLE Windows Desktop runtime, WPF included, although
       Orbit is WinForms only. Drop WPF (managed + its native DLLs) and the WinForms designer / VB parts: nothing Orbit
       or WinForms references reaches them (checked with an assembly-reference walk of the publish output).
       Removed from RuntimePackAsset, so the bundled deps.json does not list them either (WindowsBase: the small .NET
       facade of the same name stays). Using WPF or a PropertyGrid one day = take those names out of the list. -->
  <Target Name="OrbitDropUnusedDesktopRuntime" AfterTargets="ResolveRuntimePackAssets" Condition="'$(SelfContained)' == 'true'">
    <PropertyGroup>
      <_OrbitDropPattern>^(PresentationCore|PresentationFramework|PresentationFramework-System\w+|PresentationFramework\.(Aero|Aero2|AeroLite|Classic|Luna|Royale)|PresentationUI|ReachFramework|System\.Printing|System\.Xaml|System\.IO\.Packaging|System\.Windows\.Controls\.Ribbon|System\.Windows\.Input\.Manipulations|System\.Windows\.Presentation|UIAutomationClient|UIAutomationClientSideProviders|UIAutomationProvider|UIAutomationTypes|WindowsBase|WindowsFormsIntegration|DirectWriteForwarder|D3DCompiler_47_cor3|PenImc_cor3|PresentationNative_cor3|vcruntime140_cor3|wpfgfx_cor3|System\.Windows\.Forms\.Design|System\.Windows\.Forms\.Design\.Editors|System\.Design|System\.Drawing\.Design|Microsoft\.VisualBasic\.Forms)(\.resources)?$</_OrbitDropPattern>
    </PropertyGroup>
    <ItemGroup>
      <_OrbitDropAsset Include="@(RuntimePackAsset)" Condition="$([System.String]::Copy('%(RuntimePackAsset.NuGetPackageId)').StartsWith('Microsoft.WindowsDesktop.App.Runtime')) and $([System.Text.RegularExpressions.Regex]::IsMatch('%(RuntimePackAsset.Filename)', '$(_OrbitDropPattern)'))" />
      <RuntimePackAsset Remove="@(_OrbitDropAsset)" />
      <ReferenceCopyLocalPaths Remove="@(_OrbitDropAsset)" />
    </ItemGroup>
  </Target>

</Project>
